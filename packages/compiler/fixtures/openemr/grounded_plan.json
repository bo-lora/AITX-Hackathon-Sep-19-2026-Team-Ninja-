            "fname": "first_name",
            "lname": "last_name",
            "DOB": "dob",
            "sex": "sex"
          }
        },
        {
          "method": "POST",
          "path": "/api/patient/{puuid}/encounter",
          "purpose": "Create a new encounter for the registered patient.",
          "maps_from": ["create_encounter"],
          "params": {
