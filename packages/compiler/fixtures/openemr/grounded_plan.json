{
  "spec_title": "OpenEMR API",
  "spec_version": "8.4.0",
  "spec_path": "fixtures/openemr/openapi.yaml",
  "workflows": [
    {
      "workflow_name": "Schedule and Check-in Patient",
      "goal": "Schedule an appointment for an existing patient and mark them as arrived to generate an encounter.",
      "inputs_observed": [
        "patient_name",
        "appointment_date",
        "appointment_time",
        "appointment_status"
      ],
      "apis": [
        {
          "method": "GET",
          "path": "/api/patient",
          "purpose": "Search for a patient by name.",
          "maps_from": ["search_patient"],
          "params": {"fname": "patient_name"}
        },
        {
          "method": "POST",
          "path": "/api/patient/{pid}/appointment",
          "purpose": "Create a new appointment for the patient.",
          "maps_from": ["create_appointment"],
          "params": {
            "pid": "patient_id",
            "pc_eventDate": "appointment_date",
            "pc_startTime": "appointment_time",
            "pc_apptstatus": "appointment_status"
          }
        }
      ],
      "unmapped": [
        {
          "action": "update_appointment_status",
          "reason": "Check-in and status update to Arrived is UI-only; no API for status change."
        }
      ]
    },
    {
      "workflow_name": "Register Patient and Create Encounter",
      "goal": "Register a new patient with demographics and create a new encounter for their visit.",
      "inputs_observed": [
