{
  "manifest_version": 3,
  "name": "ContextNinja",
  "version": "0.1.0",
  "description": "Record a real Chrome workflow, then confirm it in the ContextNinja webapp. No API keys.",
  "action": {
    "default_title": "ContextNinja",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["activeTab", "scripting", "storage", "tabs"],
  "host_permissions": [
    "http://127.0.0.1:43124/*",
    "http://localhost:43124/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
