# The automation server reads only OE_SITE_URL and PORT. No API keys are needed for the demo.
# Demo instance: /a (clean backup). Main (https://demo.openemr.io/openemr) is for testing; /b is the fallback.
OE_SITE_URL=https://demo.openemr.io/a/openemr
PORT=4710

# OPTIONAL integrations only (supabase-sync/, docs-crawl/). Leave empty to run without them.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
APIFY_TOKEN=
