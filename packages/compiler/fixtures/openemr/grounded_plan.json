    {
      "workflow_name": "Schedule Future Appointment",
      "goal": "Schedule a follow-up appointment for the patient directly from their dashboard.",
      "inputs_observed": ["visit_category", "appointment_date", "appointment_time"],
      "apis": [
        {
          "method": "POST",
          "path": "/api/patient/{pid}/appointment",
