{
  "name": "contextninja",
  "private": true,
  "packageManager": "pnpm@10.27.0",
  "scripts": {
    "dev": "pnpm --filter @contextninja/landing-page --filter @contextninja/skill-manager --parallel dev",
    "dev:landing": "pnpm --filter @contextninja/landing-page dev",
    "dev:skills": "pnpm --filter @contextninja/skill-manager dev",
    "engine": "npm start --prefix packages/engine",
    "pack:extension": "bash scripts/pack-extension.sh",
    "build": "pnpm --filter @contextninja/landing-page --filter @contextninja/skill-manager build",
    "lint": "pnpm --filter @contextninja/landing-page --filter @contextninja/skill-manager lint"
  }
}
